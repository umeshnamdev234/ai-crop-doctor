# Settings for `docker compose` (copy to .env). All values are optional.

# Password for the bundled PostgreSQL container (local use only — change it)
POSTGRES_PASSWORD=change-me-local-only

# Use an external PostgreSQL instead of the bundled one:
# DATABASE_URL=postgresql://<user>:<password>@host.docker.internal:5432/<database>

# Model server (any OpenAI-compatible endpoint). Default: Ollama on your machine.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gemma3:4b
LLM_API_KEY=

# Origins allowed to call the API (the Next.js frontend)
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

# Optional keys: APP_API_KEY protects all routes, ADMIN_API_KEY enables admin write routes
APP_API_KEY=
ADMIN_API_KEY=

# Load SAMPLE experts, products and centres when the tables are empty
SEED_SAMPLE_DATA=true

# Host ports
API_PORT=8100
DB_PORT=5434
